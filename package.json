{
  "name": "tango-stream-manager",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "turbo dev",
    "desktop:dev": "pnpm --filter @tango-stream-manager/desktop tauri dev",
    "desktop:build": "pnpm --filter @tango-stream-manager/desktop tauri build",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.11.2"
  }
}
